# Hume credentials. Server-side only: these mint short-lived access tokens and
# must never be exposed to the browser. https://app.hume.ai/keys
HUME_API_KEY=
HUME_SECRET_KEY=

# Produced by `npm run setup:hume`. This is an identifier, not a credential,
# which is why it is safe to expose to the client.
NEXT_PUBLIC_HUME_CONFIG_ID=

# Supermemory, for cross-session personalisation. Server-side only.
# https://supermemory.ai
SUPERMEMORY_API_KEY=
